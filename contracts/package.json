{
  "name": "@confidential-pooltogether/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "compile": "hardhat compile",
    "check-deployer": "hardhat run scripts/check-deployer.cjs --network sepolia",
    "deploy": "hardhat run scripts/deploy.cjs --network sepolia",
    "deploy:usdc": "TOKEN_SYMBOL=cUSDC hardhat run scripts/deploy.cjs --network sepolia",
    "deploy:vault": "hardhat run scripts/deploy-vault.cjs --network sepolia",
    "deploy:vault:usdc": "TOKEN_SYMBOL=cUSDC hardhat run scripts/deploy-vault.cjs --network sepolia",
    "fund:vault": "hardhat run scripts/fund-vault.cjs --network sepolia",
    "fund:vault:usdc": "TOKEN_SYMBOL=cUSDC hardhat run scripts/fund-vault.cjs --network sepolia",
    "deposit:test-accounts:usdc": "hardhat run scripts/deposit-test-accounts-usdc.cjs --network sepolia",
    "live:prepare": "hardhat run scripts/prepare-live-demo.cjs --network sepolia",
    "live:prepare:usdc": "TOKEN_SYMBOL=cUSDC hardhat run scripts/prepare-live-demo.cjs --network sepolia",
    "live:evidence": "hardhat run scripts/live-evidence.cjs --network sepolia",
    "live:evidence:usdc": "TOKEN_SYMBOL=cUSDC hardhat run scripts/live-evidence.cjs --network sepolia",
    "live:cycle": "SEPOLIA_RPC_URL=https://eth-sepolia.api.onfinality.io/public hardhat run scripts/live-cycle.cjs --network sepolia",
    "test": "hardhat test",
    "verify-deployment": "hardhat run scripts/verify-deployment.cjs --network sepolia",
    "verify-deployment:usdc": "TOKEN_SYMBOL=cUSDC hardhat run scripts/verify-deployment.cjs --network sepolia",
    "verify:vault": "hardhat run scripts/verify-vault.cjs --network sepolia",
    "verify:vault:usdc": "TOKEN_SYMBOL=cUSDC hardhat run scripts/verify-vault.cjs --network sepolia",
    "verify-source": "hardhat run scripts/verify-source.cjs --network sepolia"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "^0.4.2",
    "@fhevm/solidity": "^0.11.1",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/confidential-contracts": "^0.5.1",
    "@openzeppelin/contracts": "^5.6.1",
    "hardhat": "^2.28.0",
    "ts-node": "^10.9.2"
  }
}
