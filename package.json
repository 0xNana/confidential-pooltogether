{
  "name": "confidential-pooltogether",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "contracts",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "preview": "npm run preview -w frontend",
    "build": "npm run build -w frontend",
    "browser:smoke": "npm run browser:smoke -w frontend",
    "contracts:compile": "npm run compile -w contracts",
    "contracts:check-deployer": "npm run check-deployer -w contracts",
    "contracts:deploy": "npm run deploy -w contracts",
    "contracts:deploy:usdc": "TOKEN_SYMBOL=cUSDC npm run deploy -w contracts",
    "contracts:deploy:vault": "npm run deploy:vault -w contracts",
    "contracts:deploy:vault:usdc": "TOKEN_SYMBOL=cUSDC npm run deploy:vault -w contracts",
    "contracts:test": "npm run test -w contracts",
    "contracts:verify-deployment": "npm run verify-deployment -w contracts",
    "contracts:verify-deployment:usdc": "TOKEN_SYMBOL=cUSDC npm run verify-deployment -w contracts",
    "contracts:verify:vault": "npm run verify:vault -w contracts",
    "contracts:verify:vault:usdc": "TOKEN_SYMBOL=cUSDC npm run verify:vault -w contracts",
    "contracts:verify-source": "npm run verify-source -w contracts",
    "contracts:verify-source:usdc": "TOKEN_SYMBOL=cUSDC npm run verify-source -w contracts",
    "contracts:fund:vault": "npm run fund:vault -w contracts",
    "contracts:fund:vault:usdc": "TOKEN_SYMBOL=cUSDC npm run fund:vault -w contracts",
    "contracts:live:prepare": "npm run live:prepare -w contracts",
    "contracts:live:prepare:usdc": "npm run live:prepare:usdc -w contracts",
    "contracts:live:evidence": "npm run live:evidence -w contracts",
    "contracts:live:evidence:usdc": "npm run live:evidence:usdc -w contracts",
    "contracts:live:cycle": "npm run live:cycle -w contracts",
    "events:index": "npm run index -w backend",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint .",
    "test": "npm run test -w frontend"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vercel": "^59.3.0"
  },
  "overrides": {
    "@coinbase/cdp-sdk": {
      "axios": "1.20.0"
    },
    "@walletconnect/jsonrpc-ws-connection": {
      "ws": "8.21.3"
    }
  }
}
